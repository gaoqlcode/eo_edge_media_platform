# 通用 Python 微服务镜像
FROM python:3.10-slim
WORKDIR /app
COPY platform/libs/emp_py /app/emp_py_pkg
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
ENV PYTHONPATH=/app/emp_py_pkg
# 构建时通过 --build-arg SERVICE=device_service 指定
ARG SERVICE=device_service
COPY platform/services/${SERVICE}/app.py /app/app.py
EXPOSE 8000
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
